; Engine configuration file.
config_version=5

[application]

config/name="I AM GOD"
config/description="Vous êtes Dieu. Chaque geste réécrit l'histoire, des dinosaures au cyberpunk."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameState="*res://src/core/game_state.gd"
Narrator="*res://src/ai/narrator.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="forward_plus"
; GPU en priorité : le rendu de la planète et le calcul des champs passent par des shaders.
rendering_device/driver.windows="d3d12"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_2d=2

[threading]

; CPU en priorité : la simulation est répartie sur tous les coeurs via WorkerThreadPool.
worker_pool/max_threads=-1
worker_pool/low_priority_thread_ratio=0.25
